# Ollama (class default — free, local, no key)
LLM_API_BASE_URL=http://localhost:11434
LLM_API_KEY=unused
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2

# OpenAI alternative (paid; uncomment + comment the Ollama block above)
# LLM_API_BASE_URL=https://api.openai.com
# LLM_API_KEY=sk-your-key-here
# EMBEDDING_MODEL=text-embedding-3-small   # 1536-dim, change VectorField accordingly
# LLM_MODEL=gpt-4o-mini
